{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.build.json",
    "tsconfig.node.json"
  ],
  "globalPassThroughEnv": [
    "CF_PAGES",
    "CF_PAGES_URL",
    "CF_PAGES_BRANCH",
    "CF_PAGES_COMMIT_SHA",
    "CI",
    "VITEPRESS_BASE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".vitepress/dist/**", "storybook-static/**"],
      "env": ["CF_PAGES", "CF_PAGES_URL", "CI", "VITEPRESS_BASE"],
      "passThroughEnv": [
        "CF_PAGES",
        "CF_PAGES_URL",
        "CF_PAGES_BRANCH",
        "CF_PAGES_COMMIT_SHA",
        "CI",
        "VITEPRESS_BASE"
      ],
      "inputs": [
        "src/**",
        "stories/**",
        ".storybook/**",
        "public/**",
        ".vitepress/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts"
      ]
    },
    "build:watch": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:ui": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
