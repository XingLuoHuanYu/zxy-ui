{
  "name": "@zxy-ui/vue",
  "version": "2.0.0",
  "author": "Jannik",
  "private": false,
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "main": "./dist/esm/index.esm.js",
  "style": "./dist/esm/vue.css",
  "unpkg": "./dist/umd/index.umd.js",
  "module": "./dist/esm/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/esm/index.esm.js",
      "require": "./dist/umd/index.umd.js",
      "default": "./dist/esm/index.esm.js"
    },
    "./style": {
      "types": "./dist/types/style.d.ts",
      "import": "./dist/umd/vue.css",
      "require": "./dist/umd/vue.css",
      "default": "./dist/umd/vue.css"
    }
  },
  "homepage": "https://XingLuoHuanYu.github.io/zxy-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XingLuoHuanYu/zxy-ui.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/XingLuoHuanYu/zxy-ui/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "component-library",
    "ui",
    "tailwindcss",
    "tailwind",
    "protable",
    "zxy-ui"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "!**/*.test.*",
    "!**/*.spec.*"
  ],
  "scripts": {
    "build-only": "run-p type-check \"build-only {@}\" --",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint --ext .ts,.vue .",
    "lint:fix": "eslint --ext .ts,.vue . --fix",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vueuse/core": "^13.0.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "@zxy-ui/shared": "workspace:*"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.8"
  },
  "description": "A delightful Vue 3 + Tailwind CSS component library. Ships ProTable — a search-driven advanced table with pagination, selection and remote data — plus 40+ ready-to-use components."
}